# Postgres connection string. Locally, run `npx prisma dev` and copy the printed
# TCP url here. In production, use your Neon (or other Postgres) connection string.
DATABASE_URL=""

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google Gemini (free tier) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Max Gemini evaluations one user may run per UTC day. Set to "0" to switch
# evaluations off entirely. Defaults to 5 if unset or not a whole number.
DAILY_EVAL_LIMIT="5"

# Max evaluations across ALL users per UTC day. Leave unset for no ceiling.
#
# This is the one that actually protects a shared free-tier key: registration is open,
# so a determined abuser just creates accounts and the per-user limit above only
# governs how fast each one burns through. Set it before deploying publicly.
GLOBAL_DAILY_EVAL_LIMIT=""
