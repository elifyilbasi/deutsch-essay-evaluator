# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real ones never, the template always. The README tells a new developer
# to copy .env.example, so ignoring it makes a fresh clone impossible to configure.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Copyrighted exam papers used as format reference only - never committed or deployed.
# Folder structure and README are kept; see exam-materials/README.md
exam-materials/**/*.pdf
exam-materials/**/*.png
exam-materials/**/*.jpg
exam-materials/**/*.jpeg

# Personal writing kept alongside the reference material, not project content.
exam-materials/your-draft-*.txt

# Vendor docs installed by `prisma init` for AI tooling, plus its lockfile and the
# symlinks that point into them. Any clone regenerates these, so the rule belongs
# with the project. Purely personal files (.claude/settings.local.json, editor
# directories) are a global excludesFile concern instead.
# .claude/launch.json stays tracked: it is real project config.
.agents/
skills-lock.json
.claude/skills/
.windsurf/
