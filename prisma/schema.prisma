// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) models ---
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Vestigial: sign-in is Google-only, and nothing reads or writes this any more. Kept
  /// for one release as the way back if OAuth has to be rolled back — dropping a column
  /// discards the hashes irreversibly, and there is no cost to leaving it null.
  passwordHash  String?

  accounts   Account[]
  sessions   Session[]
  essays     Essay[]
  dailyUsage DailyUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain models ---

enum Institute {
  TELC
  GOETHE
}

/// The full ladder this product will ever cover. C1 is deliberately absent rather than
/// carried unused: an enum value nothing can produce still has to be handled at every
/// exhaustive switch and every lookup that must not silently fall back to it.
enum Level {
  A1
  A2
  B1
  B2
}

/// Only what cannot be derived. Whether an essay has been evaluated is whether an
/// Evaluation row exists for it — storing that as a third status here meant the two
/// could disagree, and an essay whose evaluation was gone still claimed EVALUATED.
enum EssayStatus {
  DRAFT
  SUBMITTED
}

/// Whether the task expects the informal "du" or the formal "Sie" register.
/// Graded as part of Kommunikative Gestaltung.
enum Register {
  DU
  SIE
}

/// Why the candidate is writing — the communicative purpose of the task.
///
/// Deliberately NOT called Textsorte: telc fixes the Textsorte per level (a personal or
/// semi-formal message at B1, a semi-formal or formal e-mail at B2, see
/// src/lib/rubrics/telc.ts) and marks against it. This is the axis that varies *within*
/// a level, and it is not marked at all — it exists so a learner can find their way
/// around a bank of 39 B2 tasks.
///
/// As with Level's absent C1, no member is carried that nothing produces. There is no
/// SONSTIGES: every seeded task classifies, and a task that genuinely would not is a
/// signal to add the member it needs rather than to file it under "other".
enum Schreibanlass {
  /// Something went wrong and the candidate says so. The bulk of telc B2.
  BESCHWERDE
  /// Asking for information the advertisement or notice did not give.
  ANFRAGE
  /// Applying for a post, a placement or a course.
  BEWERBUNG
  /// Offering one's own help or services unasked.
  ANGEBOT
  /// Explaining an absence or a failure to do something.
  ENTSCHULDIGUNG
  /// Telling someone what they need to know, expecting nothing back.
  MITTEILUNG
  /// Replying to a letter, e-mail or message the task prints. The whole of telc B1.
  ANTWORT
}

/// Mirrors the structure of a real TELC/Goethe "Schriftlicher Ausdruck" (Brief) task:
/// an intro line, an incoming stimulus letter, and a set of discrete content points
/// (Leitpunkte) the candidate must each address.
model Prompt {
  id        String    @id @default(cuid())
  institute Institute
  level     Level
  title     String

  /// e.g. "Eine Bekannte hat Ihnen folgenden Brief geschrieben:"
  taskIntro      String   @db.Text
  /// The incoming letter the candidate replies to. Null for non-reactive tasks.
  stimulusText   String?  @db.Text
  /// Name of the person who wrote the stimulus letter, so the reply can address them.
  stimulusAuthor String?
  /// e.g. "Antworten Sie Ihrer Bekannten. Schreiben Sie etwas zu den folgenden vier Punkten:"
  instructions   String   @db.Text
  /// The content points, kept as discrete items because completeness is graded per point.
  leitpunkte     String[]

  register        Register @default(DU)
  /// Whether the task requires a subject line (Betreff).
  requiresSubject Boolean  @default(false)
  /// Why the candidate is writing. Drives the task picker's Anlass filter; not marked.
  /// No default: a task whose Anlass has not been decided is a task nobody classified,
  /// and silently filing it under one of these would be a worse answer than failing.
  schreibanlass   Schreibanlass

  minWords Int
  /// Null where the level prints a floor and no ceiling (telc B2: "mindestens 150 Wörter").
  maxWords Int?
  isActive Boolean @default(true)

  essays Essay[]

  createdAt DateTime @default(now())

  @@index([institute, level, isActive])
}

model Essay {
  id        String      @id @default(cuid())
  userId    String
  promptId  String
  institute Institute
  level     Level
  content   String      @db.Text
  wordCount Int
  status    EssayStatus @default(DRAFT)

  /// Seconds spent writing, measured from the first keystroke. Null for essays
  /// written before timing existed.
  writingSeconds Int?

  /// Client-supplied id for one submit attempt, so a retry after an ambiguous
  /// timeout returns the first essay instead of paying for a second evaluation.
  /// Nullable because rows written before this existed have none, and Postgres
  /// allows any number of NULLs under a unique index.
  submissionId String? @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt Prompt @relation(fields: [promptId], references: [id])

  evaluation Evaluation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

/// One row per user per UTC day, holding the evaluations charged to them.
///
/// Deliberately NOT derived from Essay or Evaluation. Both are user-deletable, and
/// quota used to be `count(Evaluation)` for today — so submitting, reading the
/// result and deleting the essay refunded the quota, giving unlimited paid calls on
/// a shared free-tier key. Nothing in the app deletes these rows.
model DailyUsage {
  userId String
  /// UTC calendar day as "YYYY-MM-DD". A string rather than @db.Date: under driver
  /// adapters the pg driver parses DATE into a local-time Date, which shifts the day
  /// either side of midnight. The app has always counted UTC days.
  day    String
  /// Evaluations charged today, successful or not. Incremented before the model call,
  /// so deliberately inducing a failure costs the same as a success.
  used   Int    @default(0)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@id([userId, day])
  @@index([day])
}

/// A counter for one named thing inside one time window — currently only Gemini calls
/// in the current minute. Not per user, so it has no relation to User.
///
/// The row is reused rather than accumulated: a claim that finds a stale `window`
/// overwrites it and starts the count at 1. So this table holds exactly one row however
/// busy the app gets, and nothing ever needs pruning.
///
/// It was also carrying a per-IP registration throttle, which went away with the
/// email/password sign-up — making accounts expensive is Google's job now.
model RateWindow {
  /// What is being counted, e.g. "gemini".
  id     String @id
  /// The UTC minute ("YYYY-MM-DDTHH:MM") this count belongs to. A count is only valid
  /// for the window recorded here.
  window String
  used   Int    @default(0)

  updatedAt DateTime @updatedAt
}

model Evaluation {
  id      String @id @default(cuid())
  essayId String @unique

  /// Score on the institute's official scale (e.g. 0-45 for telc B1, 0-10 for A1).
  /// Float, not Int: telc A1 awards half marks (3 / 1,5 / 0 per Inhaltspunkt).
  overallScore Float
  /// Maximum for that scale, stored so historical rows survive rubric changes.
  maxScore     Float
  /// Pre-multiplier criterion total, as it appears on the examiner mark sheet.
  rawScore     Float
  /// Set when a zero-out rule fired (e.g. "Thema verfehlt").
  zeroedReason String?

  resultLabel       String
  criteriaScores    Json
  /// Per-Leitpunkt completeness: [{ leitpunkt, addressed, comment }]
  leitpunktCoverage Json
  corrections       Json
  summaryFeedback   String @db.Text
  rawModelResponse  Json

  essay Essay @relation(fields: [essayId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
